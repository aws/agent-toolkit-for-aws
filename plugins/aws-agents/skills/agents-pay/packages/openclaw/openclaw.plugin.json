{
  "id": "x402-payments",
  "name": "x402 Payments",
  "description": "Transparent x402 paywall auto-pay via AWS AgentCore Payments",
  "contracts": {
    "tools": [
      "get_payment_session_status",
      "get_paid_content"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "region": { "type": "string", "default": "us-east-1" },
      "paymentManagerArn": { "type": "string" },
      "paymentInstrumentId": { "type": "string" },
      "userId": { "type": "string" },
      "payment_session_id": { "type": "string" },
      "networkPreferences": { "type": "array", "items": { "type": "string" } },
      "allowedRecipients": { "type": "array", "items": { "type": "string" } },
      "allowedAssets": { "type": "array", "items": { "type": "string" } },
      "maxPaymentAmountAtomic": { "type": "string", "default": "100000" }
    },
    "required": ["paymentManagerArn", "paymentInstrumentId", "userId", "payment_session_id", "allowedRecipients"]
  }
}
