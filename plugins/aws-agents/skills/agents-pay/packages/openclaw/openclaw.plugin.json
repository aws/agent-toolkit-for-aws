{
  "id": "agentcore-payments",
  "name": "AgentCore Payments",
  "description": "Guarded x402 v2 payments through AWS AgentCore Payments",
  "contracts": {
    "tools": [
      "get_payment_session_status",
      "get_paid_content"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "region": { "type": "string", "default": "us-east-1" },
      "paymentManagerArn": { "type": "string" },
      "paymentInstrumentId": { "type": "string" },
      "userId": { "type": "string" },
      "payment_session_id": { "type": "string" },
      "networkPreferences": { "type": "array", "items": { "type": "string" } },
      "allowedOrigins": { "type": "array", "items": { "type": "string" } },
      "allowedRecipients": { "type": "array", "items": { "type": "string" } },
      "allowedAssetsByNetwork": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "maxPaymentAmountAtomic": { "type": "string", "default": "100000" }
    },
    "required": []
  }
}
