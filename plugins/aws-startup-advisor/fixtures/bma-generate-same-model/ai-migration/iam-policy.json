{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockInvokeModelScoped",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/openai.gpt-5.6-terra",
        "arn:aws:bedrock:us-east-1:ACCOUNT_ID:inference-profile/us.openai.gpt-5.6-terra",
        "arn:aws:bedrock:us-east-1:ACCOUNT_ID:project/default"
      ]
    },
    {
      "Sid": "BedrockGetInferenceProfile",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetInferenceProfile"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1:ACCOUNT_ID:inference-profile/us.openai.gpt-5.6-terra"
      ]
    }
  ]
}
