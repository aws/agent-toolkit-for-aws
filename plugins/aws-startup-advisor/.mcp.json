{
  "mcpServers": {
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/aws/mcp-proxy-for-aws@3f655f0f5421b35fd3c2f0959996170d10286587",
        "mcp-proxy-for-aws",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--skip-auth",
        "--metadata",
        "INSTALL_SOURCE=agent-toolkit-startup-advisor"
      ]
    }
  }
}
