        "sections": {
          "Live discovery extensions": "",
          "@L128": "resources[]"
        },
        "ignore_headings": [
          "gcp-resource-clusters.json"
        ],
        "open_paths": [
          "resources[].config"
        ],
        "_open_paths_why": "schema-discover-iac.md documents one sample config; per-resource-type config shapes are not published, so config keys cannot be judged unknown.",
        "_sections_why": "@L128 is the single-resource 'Example:' block under the inventory heading; it documents one resources[] item, not the root. 'Live discovery extensions' documents root-level additions (metadata, resources[], live_metadata), so it merges into the root.",
        "extra_shapes": [
          {
            "shape": "skills/gcp-to-aws/references/shared/schema-graviton.md",
