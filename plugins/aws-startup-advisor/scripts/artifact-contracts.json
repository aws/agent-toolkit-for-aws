{
  "_what_this_is": "Maps each migration artifact (by file name, fnmatch glob) to the contract document that defines it. Read by scripts/validate-artifacts.py. 'shape' points at a markdown document whose JSON/JSONC example block IS the contract; 'root_heading' selects which block (exact or word-boundary prefix match on the heading text, backticks ignored — 'graviton' matches '`graviton` block …' but not '`graviton_profile` …'); 'sections' maps sub-section headings to the key path they refine when the heading's own backticked token is not the path; 'json_schema' points at a real JSON Schema. Both may be present — the schema is authoritative where it speaks, the shape catches keys the schema leaves open.",
  "fixture_prefixes": {
    "gcp-": "gcp-to-aws",
    "heroku-": "heroku-to-aws",
    "azure-": "azure-to-aws"
  },
  "shared": {
    ".phase-status.json": {
      "json_schema": "skills/shared/state/phase-status.schema.json"
    },
    "integration-validation.json": {
      "json_schema": "scripts/contracts/integration-validation.schema.json"
    },
    "ai-workload-profile.json": {
      "json_schema": "scripts/contracts/ai-workload-profile.schema.json"
    },
    "aws-design-ai.json": {
      "json_schema": "scripts/contracts/aws-design-ai.schema.json"
    }
  },
  "skills": {
