{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:awslabs:startups:ai:model-registry",
  "title": "Bedrock model registry",
  "description": "Contract for skills/shared/ai/models/bedrock-model-registry.json, the single hand-edited source for the per-provider model-selection catalogs. tools/build-model-catalogs.py renders each view to its catalog (validated by model-selection-catalog.schema.json) and checks references the schema cannot express: every view entry names an existing record, every capability is canonical and mapped, every record is used, and only evidence is overridden per path.",
  "type": "object",
  "required": ["registry_version", "description", "capability_vocabulary", "models", "views"],
  "additionalProperties": false,
  "properties": {
    "registry_version": { "type": "integer", "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "capability_vocabulary": {
      "description": "Canonical capability terms used by registry records; each view maps them to its module's vocabulary.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/capability" }
    },
    "models": {
      "description": "One record per Bedrock model, keyed by a stable registry key.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/record" }
    },
    "views": {
      "type": "object",
      "required": ["anthropic", "openai"],
      "additionalProperties": false,
      "properties": {
        "anthropic": { "$ref": "#/definitions/view" },
        "openai": { "$ref": "#/definitions/view" }
      }
    }
  },
  "definitions": {
    "capability": {
      "type": "string",
      "enum": ["tool_calling", "reasoning", "image_input", "long_context", "prompt_caching", "streaming", "structured_output_json"]
    },
    "capabilityList": { "type": "array", "items": { "$ref": "#/definitions/capability" } },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tokenLimit": {
      "anyOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "const": "unknown" }
      ]
    },
    "recordPath": {
      "type": "object",
      "required": ["available", "model_id", "requires_cris"],
      "additionalProperties": false,
      "properties": {
        "available": { "type": "boolean" },
        "model_id": { "type": "string", "minLength": 1 },
        "requires_cris": { "type": "boolean" },
        "regions": { "$ref": "#/definitions/stringList" },
        "supported_regions": { "$ref": "#/definitions/stringList" },
        "inference_profile_regions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/stringList" }
        },
        "capabilities": { "$ref": "#/definitions/capabilityList" }
      }
    },
    "record": {
      "type": "object",
      "required": ["provider", "selection_status", "context_window", "output_token_ceiling", "capabilities", "paths"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "enum": ["anthropic", "openai"] },
        "selection_status": { "type": "string", "enum": ["selectable", "reference_only"] },
        "context_window": { "$ref": "#/definitions/tokenLimit" },
        "output_token_ceiling": { "$ref": "#/definitions/tokenLimit" },
        "capabilities": { "$ref": "#/definitions/capabilityList" },
        "lifecycle_status": { "type": "string", "minLength": 1 },
        "launch_date": { "$ref": "#/definitions/isoDate" },
        "eol_no_sooner_than": { "$ref": "#/definitions/isoDate" },
        "default_effort": { "type": "string", "minLength": 1 },
        "adaptive_thinking_only": { "type": "boolean" },
        "batch_supported": { "type": "boolean" },
        "forced_tool_choice_supported": { "type": "boolean" },
        "native_structured_output_supported": { "type": "boolean" },
        "sampling_parameters_supported": { "type": "boolean" },
        "runtime_in_region_regions": { "$ref": "#/definitions/stringList" },
        "runtime_in_region_verified_at": { "$ref": "#/definitions/isoDate" },
        "mantle_regions": { "$ref": "#/definitions/stringList" },
        "service_tiers": { "$ref": "#/definitions/stringList" },
        "inference_profiles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/stringList" }
        },
        "region_availability": {
          "type": "object",
          "required": ["commercial", "govcloud"],
          "additionalProperties": false,
          "properties": {
            "commercial": { "$ref": "#/definitions/stringList" },
            "govcloud": { "$ref": "#/definitions/stringList" },
            "evidence": { "type": "string" }
          }
        },
        "paths": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/recordPath" }
        }
      }
    },
    "viewEntry": {
      "description": "One catalog model: the registry record it renders plus view-specific fields.",
      "type": "object",
      "required": ["model", "display_name", "family", "version", "class", "paths"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "generation": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "capability_source": { "type": "string" },
        "evidence": { "type": "string" },
        "paths": {
          "description": "Paths this view exposes, in output order, with per-path evidence overrides.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "evidence": { "type": "string" } }
          }
        }
      }
    },
    "view": {
      "type": "object",
      "required": ["catalog", "header", "capabilities", "paths", "models"],
      "additionalProperties": false,
      "properties": {
        "catalog": { "type": "string", "pattern": "^[a-z]+-bedrock\\.json$" },
        "header": { "type": "object" },
        "capabilities": {
          "description": "Canonical capability -> this module's term, or null to omit it.",
          "type": "object",
          "additionalProperties": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
        },
        "paths": { "type": "object", "minProperties": 1 },
        "models": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/viewEntry" }
        }
      }
    }
  }
}
