{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:awslabs:startups:migration:ai-migration-scenario",
  "title": "AI migration scenario snapshot",
  "description": "Target-only compositional contract for representative infrastructure and AI migration scenarios. Structural validity does not assert current runtime support; a versioned runtime capability catalog is a later deliverable.",
  "type": "object",
  "required": ["id", "mode", "migration_id", "run_id", "state", "dimensions", "outcomes"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "#/definitions/identifier"},
    "mode": {"enum": ["infrastructure_only", "ai_only", "combined"]},
    "migration_id": {"$ref": "#/definitions/identifier"},
    "run_id": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"},
    "state": {"const": ".phase-status.json"},
    "dimensions": {
      "type": "object",
      "required": ["infrastructure_source", "ai_sources", "gateways"],
      "additionalProperties": false,
      "properties": {
        "infrastructure_source": {
          "description": "Option A: zero or one infrastructure source per migration run. Polycloud or multiple simultaneous infrastructure sources are outside this contract and deferred.",
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/definitions/extensibleIdentity"}
          ]
        },
        "ai_sources": {
          "description": "Retained AI sources. Semantic uniqueness is the provider and source_service pair; duplicate or overlapping pairs are invalid, while one provider through distinct services is valid.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/aiSource"}
        },
        "gateways": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/gateway"}
        }
      }
    },
    "outcomes": {
      "type": "object",
      "required": ["infrastructure", "ai", "integration_validation"],
      "additionalProperties": false,
      "properties": {
        "infrastructure": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/trackOutcome"}]},
        "ai": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/trackOutcome"}]},
        "integration_validation": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/integrationOutcome"}]}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "mode": {"const": "infrastructure_only"},
        "dimensions": {
          "properties": {
            "infrastructure_source": {"$ref": "#/definitions/extensibleIdentity"},
            "ai_sources": {"maxItems": 0},
            "gateways": {"maxItems": 0}
          }
        },
        "outcomes": {
          "properties": {
            "infrastructure": {"$ref": "#/definitions/trackOutcome"},
            "ai": {"type": "null"},
            "integration_validation": {"type": "null"}
          }
        }
      }
    },
    {
      "properties": {
        "mode": {"const": "ai_only"},
        "dimensions": {
          "properties": {
            "infrastructure_source": {"type": "null"},
            "ai_sources": {"minItems": 1}
          }
        },
        "outcomes": {
          "properties": {
            "infrastructure": {"type": "null"},
            "ai": {"$ref": "#/definitions/trackOutcome"},
            "integration_validation": {"type": "null"}
          }
        }
      }
    },
    {
      "properties": {
        "mode": {"const": "combined"},
        "dimensions": {
          "properties": {
            "infrastructure_source": {"$ref": "#/definitions/extensibleIdentity"},
            "ai_sources": {"minItems": 1}
          }
        },
        "outcomes": {
          "properties": {
            "infrastructure": {"$ref": "#/definitions/trackOutcome"},
            "ai": {"$ref": "#/definitions/trackOutcome"},
            "integration_validation": {"$ref": "#/definitions/integrationOutcome"}
          }
        }
      }
    }
  ],
  "definitions": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "extensibleIdentity": {"type": "string", "pattern": "^(?!(?:both|openrouter|unknown)$)[a-z][a-z0-9_]*$"},
    "modelFamily": {"type": "string", "pattern": "^(?!(?:both|unknown)$)[a-z][a-z0-9_.-]*$"},
    "normalizedModel": {"type": "string", "pattern": "^(?!(?:both|unknown)$)[a-z0-9][a-z0-9._:/-]*$"},
    "gatewayIdentity": {"type": "string", "pattern": "^(?!(?:both|unknown)$)[a-z][a-z0-9_]*$"},
    "aiSource": {
      "description": "A structurally extensible AI source keyed semantically by provider and source_service. Exact models are observed normalized IDs or an explicitly empty not-observed set; sentinel model IDs are invalid.",
      "type": "object",
      "required": ["provider", "source_service", "model_families", "model_evidence", "models"],
      "additionalProperties": false,
      "properties": {
        "provider": {"$ref": "#/definitions/extensibleIdentity"},
        "source_service": {"$ref": "#/definitions/extensibleIdentity"},
        "model_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/modelFamily"}
        },
        "model_evidence": {"enum": ["observed", "not_observed"]},
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/normalizedModel"}
        }
      },
      "oneOf": [
        {
          "properties": {
            "model_evidence": {"const": "observed"},
            "models": {"minItems": 1}
          }
        },
        {
          "properties": {
            "model_evidence": {"const": "not_observed"},
            "models": {"maxItems": 0}
          }
        }
      ]
    },
    "upstreamModelFamily": {
      "description": "One provider-associated model family and its exact observed models, or an explicit not-observed exact-model set.",
      "type": "object",
      "required": ["family", "model_evidence", "models"],
      "additionalProperties": false,
      "properties": {
        "family": {"$ref": "#/definitions/modelFamily"},
        "model_evidence": {"enum": ["observed", "not_observed"]},
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/normalizedModel"}
        }
      },
      "oneOf": [
        {
          "properties": {
            "model_evidence": {"const": "observed"},
            "models": {"minItems": 1}
          }
        },
        {
          "properties": {
            "model_evidence": {"const": "not_observed"},
            "models": {"maxItems": 0}
          }
        }
      ]
    },
    "gatewayUpstream": {
      "description": "Authoritative provider to optional source-service provenance to family to exact-model association. Semantic uniqueness is provider plus source_service when known; duplicate or overlapping entries are invalid.",
      "type": "object",
      "required": ["provider", "model_families"],
      "additionalProperties": false,
      "properties": {
        "provider": {"$ref": "#/definitions/extensibleIdentity"},
        "source_service": {"$ref": "#/definitions/extensibleIdentity"},
        "model_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/upstreamModelFamily"}
        }
      }
    },
    "gateway": {
      "description": "Optional gateway. Observed upstreams are structured associations; unresolved explicitly means that upstream identity is unknown and requires an empty upstreams array.",
      "type": "object",
      "required": ["product", "type", "upstream_evidence", "upstreams"],
      "additionalProperties": false,
      "properties": {
        "product": {"$ref": "#/definitions/gatewayIdentity"},
        "type": {"$ref": "#/definitions/extensibleIdentity"},
        "upstream_evidence": {"enum": ["observed", "unresolved"]},
        "upstreams": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/gatewayUpstream"}
        }
      },
      "oneOf": [
        {
          "properties": {
            "upstream_evidence": {"const": "observed"},
            "upstreams": {"minItems": 1}
          }
        },
        {
          "properties": {
            "upstream_evidence": {"const": "unresolved"},
            "upstreams": {"maxItems": 0}
          }
        }
      ]
    },
    "trackOutcome": {
      "type": "object",
      "required": ["verdict", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"const": "passed"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "integrationOutcome": {
      "type": "object",
      "required": ["verdict", "artifact"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"const": "passed"},
        "artifact": {"const": "integration-validation.json"}
      }
    }
  }
}
