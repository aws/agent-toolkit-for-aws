  "gce": {
    "_how_to_read": "A machine type `<family>-<n>` has vcpu n and memory_gib n × gib_per_vcpu. `*-custom-<vcpu>-<mb>` (e.g. n2-custom-4-8192, e2-custom-2-4096, custom-4-8192 for n1) parses vcpu and memory_gib = mb / 1024 and takes the family's aws_family. Shared-core types are listed explicitly with reserved_vcpu. `aws_family` is the Graviton family; its x86 fallback is the family's `x86_fallback` above. Memory ratios from https://cloud.google.com/compute/docs/machine-resource#machine_type_comparison and the per-family pages linked below.",
    "families": {
      "e2-standard": { "gib_per_vcpu": 4, "aws_family": "m7g", "source": "https://cloud.google.com/compute/docs/general-purpose-machines#e2_machine_types" },
