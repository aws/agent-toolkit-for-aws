    "shared_core": {
      "_why": "cpu/utilization on these types is a fraction of reserved_vcpu and exceeds 1.0 under load (live: e2-small max 1.965). The formula uses reserved_vcpu; the like-for-like anchor uses the guest-visible vcpu, which is what graviton.md's e2-micro/small/medium rows already do.",
      "source": "https://cloud.google.com/compute/docs/general-purpose-machines#sharedcore",
      "types": {
        "e2-micro": { "vcpu": 2, "reserved_vcpu": 0.25, "memory_gib": 1, "aws_family": "t4g" },
        "e2-small": { "vcpu": 2, "reserved_vcpu": 0.5, "memory_gib": 2, "aws_family": "t4g" },
        "e2-medium": { "vcpu": 2, "reserved_vcpu": 1, "memory_gib": 4, "aws_family": "t4g" },
        "f1-micro": { "vcpu": 1, "reserved_vcpu": 0.2, "memory_gib": 0.6, "aws_family": "t4g" },
        "g1-small": { "vcpu": 1, "reserved_vcpu": 0.5, "memory_gib": 1.7, "aws_family": "t4g" }
      }
    }
  },
  "rds": {
    "_how_to_read": "Classes are ordered within each family. Cloud SQL `db-custom-<vcpu>-<mb>` parses like GCE custom types; `db-n1-standard-<n>` is n vCPU × 3.75 GiB and `db-n1-highmem-<n>` n × 6.5 GiB; the shared-core tiers are listed. Mapping: shared-core tiers → db.t4g (the like-for-like for db-f1-micro is db.t4g.micro, as design-refs/database.md Example 1 already says); standard/custom at or below 6 GiB per vCPU → db.m7g; highmem or custom above 6 GiB per vCPU → db.r7g. v1 never MOVES a measured database onto db.t4g: measured sizing stays inside the like-for-like family, so the EC2 credit table does not apply here.",
    "source": "https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/Concepts.DBInstanceClass.Summary.html",
    "max_connections": {
      "_what_this_is": "A formula on DBInstanceClassMemory, not a stored integer. DBInstanceClassMemory is NOT the advertised class memory: RDS subtracts what it reserves for the operating system and its management processes before the engine divisor applies (CHAP_Limits: db.m7g.large MySQL is about 630, not 8 GiB / 12582880 = 683; db.t3.micro MySQL is about 60). AWS does not publish the deduction, so reserved_memory is a fit to those two documented anchors: DBInstanceClassMemory = (memory_gib − fixed_gib − fraction × memory_gib) × 1073741824.",
      "source": "https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/CHAP_Limits.html#RDS_Limits.MaxConnections",
      "reserved_memory": { "fixed_gib": 0.25, "fraction": 0.045, "_anchors": "db.m7g.large mysql 8 GiB → 630 (documented about 630); db.t3.micro mysql 1 GiB → 60 (documented about 60)" },
      "mysql": { "formula": "floor(DBInstanceClassMemory / 12582880)", "divisor": 12582880 },
      "mariadb": { "formula": "floor(DBInstanceClassMemory / 12582880)", "divisor": 12582880 },
      "postgresql": { "formula": "min(floor(DBInstanceClassMemory / 9531392), 5000)", "divisor": 9531392, "cap": 5000 },
      "sqlserver": { "formula": "engine default 0 = unlimited; the proxy decision is skipped", "divisor": null }
    },
    "storage": {
      "_what_this_is": "gp3 is the default. Allocated = disk_bytes_used.max × bytes_used_factor (rightsizing-thresholds.json) rounded up to the next 10 GiB, never below min_allocated_gib.",
      "source": "https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/CHAP_Storage.html#gp3-storage",
      "gp3": { "min_allocated_gib": 20, "baseline_iops": 3000, "baseline_throughput_mbps": 125, "_baseline_applies_below_gib": 400 }
    },
    "families": {
      "db.t4g": {
        "architecture": "arm64",
        "classes": [
