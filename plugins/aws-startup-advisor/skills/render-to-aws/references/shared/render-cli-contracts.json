    "workflow_task_runs_list": {"argv": ["workflows", "tasks", "runs", "list", "--task", "{resource_id}", "--output", "json"], "shape": "nullable_array"},
    "workflow_task_run_show": {"argv": ["workflows", "tasks", "runs", "show", "{resource_id}", "--output", "json"], "shape": "nullable_direct_object"},
    "jobs_list": {"argv": ["jobs", "list", "{resource_id}", "--output", "json"], "shape": "array"},
    "blueprint_validate": {"argv": ["blueprints", "validate", "{blueprint}", "--workspace", "{workspace_id}", "--confirm", "--output", "json"], "shape": "blueprint_validation"},
    "log_metadata": {"argv": ["logs", "--resources", "{resource_id}", "--start", "{start}", "--end", "{end}", "--limit", "{limit}", "--direction", "backward", "--output", "json"], "shape": "json_stream_metadata"}
