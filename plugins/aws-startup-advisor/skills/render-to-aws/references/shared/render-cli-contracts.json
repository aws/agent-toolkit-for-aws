    "service_instances": {"argv": ["services", "instances", "{resource_id}", "--output", "json"], "shape": "array"},
    "deploys_list": {"argv": ["deploys", "list", "{resource_id}", "--output", "json"], "shape": "array"},
    "postgres_list": {"argv": ["postgres", "list", "--output", "json"], "shape": "data_array"},
    "postgres_get": {"argv": ["postgres", "get", "{resource_id}", "--output", "json"], "shape": "data_nullable_object"},
    "keyvalues_list": {"argv": ["keyvalues", "list", "--output", "json"], "shape": "data_array"},
    "keyvalue_get": {"argv": ["keyvalues", "get", "{resource_id}", "--output", "json"], "shape": "data_nullable_object"},
    "workflows_list": {"argv": ["workflows", "list", "--output", "json"], "shape": "nullable_wrapper_array"},
    "workflow_versions_list": {"argv": ["workflows", "versions", "list", "{resource_id}", "--output", "json"], "shape": "nullable_array"},
