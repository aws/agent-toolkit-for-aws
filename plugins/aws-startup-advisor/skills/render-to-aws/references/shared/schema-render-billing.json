{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "source", "currency", "monthly_total", "line_item_count", "conversion", "source_digest", "fingerprint"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"}, "source": {"enum": ["user_stated", "billing_export"]}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "monthly_total": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"}, "as_of": {"type": "string", "format": "date"}, "period_start": {"type": "string", "format": "date"}, "period_end": {"type": "string", "format": "date"}, "line_item_count": {"type": "integer", "minimum": 0}, "conversion": {"type": ["array", "null"]}, "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [{"if": {"properties": {"source": {"const": "user_stated"}}}, "then": {"required": ["as_of"]}}, {"if": {"properties": {"source": {"const": "billing_export"}}}, "then": {"required": ["period_start", "period_end"]}}]
}
