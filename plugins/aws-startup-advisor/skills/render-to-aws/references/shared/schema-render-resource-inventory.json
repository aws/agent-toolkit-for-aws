{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "attempt_id", "workspace_id", "resources", "edges", "drift", "discovery_sources", "accounting", "billing"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"}, "attempt_id": {"type": "string", "format": "uuid"}, "workspace_id": {"type": "string"},
    "resources": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "render_id", "name", "workspace_id", "project_id", "environment_id", "region", "config", "provenance", "confidence", "accounting_disposition"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^rr-[0-9a-f]{24}$"}, "kind": {"type": "string", "pattern": "^render\\.[a-z_]+$"}, "render_id": {"type": ["string", "null"]}, "name": {"type": "string"}, "workspace_id": {"type": "string"}, "project_id": {"type": ["string", "null"]}, "environment_id": {"type": ["string", "null"]}, "region": {"type": ["string", "null"]}, "config": {"type": "object"}, "provenance": {"type": "object"}, "confidence": {"enum": ["deterministic", "measured", "inferred", "billing_inferred", "observed_single_run"]}, "accounting_disposition": {"const": "inventory"}}}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["id", "type", "from_id", "to_id", "attributes"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^re-[0-9a-f]{24}$"}, "type": {"enum": ["service_to_postgres", "service_to_key_value", "service_to_service", "service_to_env_group", "service_to_disk", "member_of_project", "member_of_environment", "shares_repository", "private_network_peer", "custom_domain_routes_to", "service_uses_build_source", "build_source_produces_artifact", "environment_promotes_artifact", "workflow_has_version", "workflow_version_has_task", "workflow_task_has_run", "task_run_has_attempt"]}, "from_id": {"type": "string"}, "to_id": {"type": "string"}, "attributes": {"type": "object"}}}},
    "drift": {"type": "array", "items": {"type": "object", "required": ["resource_id", "field", "selected_value", "selected_source", "other_value", "other_source", "selection_reason"], "additionalProperties": false, "properties": {"resource_id": {"type": "string", "pattern": "^rr-[0-9a-f]{24}$"}, "field": {"type": "string", "minLength": 1}, "selected_value": {}, "selected_source": {"type": "string", "minLength": 1}, "other_value": {}, "other_source": {"type": "string", "minLength": 1}, "selection_reason": {"enum": ["declared_repository_intent_prefers_blueprint", "current_configuration_prefers_live_rest", "current_configuration_prefers_live_cli", "current_configuration_prefers_blueprint", "application_inference_only"]}}}}, "discovery_sources": {"type": "array", "uniqueItems": true, "items": {"enum": ["render_blueprint", "render_cli", "render_rest", "application", "billing"]}}, "accounting": {"type": "object", "required": ["resource_count", "accounted_resource_ids"], "additionalProperties": false, "properties": {"resource_count": {"type": "integer", "minimum": 0}, "accounted_resource_ids": {"type": "array", "uniqueItems": true}}}, "billing": {"type": ["object", "null"]}
  }
}
