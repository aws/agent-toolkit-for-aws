{
  "description": "Each case mutates the golden aws-design.json row named by target (set/remove apply to aws_config; aws_service replaces the target service) and must leave rr-workflow and rr-workflow-task unsupported with a reason that starts with expect.",
  "cases": [
    {"name": "express orchestrator", "target": "rr-workflow", "aws_service": "AWS Step Functions Express", "expect": "orchestrator_unsupported"},
    {"name": "durable functions orchestrator", "target": "rr-workflow", "aws_service": "AWS Lambda durable functions", "expect": "orchestrator_unsupported"},
    {"name": "history not auditable", "target": "rr-workflow", "set": {"history": "best_effort"}, "expect": "history_not_auditable"},
    {"name": "branching", "target": "rr-workflow", "set": {"branching": true}, "expect": "branching_unsupported"},
    {"name": "dynamic graph", "target": "rr-workflow", "set": {"dynamic_graph": true}, "expect": "dynamic_graph_unsupported"},
    {"name": "approvals", "target": "rr-workflow", "set": {"approvals": true}, "expect": "approvals_unsupported"},
    {"name": "trigger", "target": "rr-workflow", "set": {"trigger": "api"}, "expect": "trigger_unsupported"},
    {"name": "schedule", "target": "rr-workflow", "set": {"schedule": "daily"}, "expect": "schedule_unsupported"},
    {"name": "idempotency key", "target": "rr-workflow", "set": {"idempotency_key": true}, "expect": "idempotency_key_unsupported"},
    {"name": "run concurrency", "target": "rr-workflow", "set": {"concurrency": 2}, "expect": "concurrency_unsupported"},
    {"name": "cancellation", "target": "rr-workflow", "set": {"cancellation": true}, "expect": "cancellation_unsupported"},
    {"name": "callbacks without timeout", "target": "rr-workflow", "remove": ["callback_timeout_seconds"], "expect": "callback_timeout_missing"},
    {"name": "callback timeout below task timeout", "target": "rr-workflow", "set": {"callback_timeout_seconds": 100}, "expect": "callback_timeout_below_task_timeout"},
    {"name": "callback timeout without callbacks", "target": "rr-workflow", "set": {"callbacks": false}, "expect": "callback_timeout_without_callbacks"},
    {"name": "task order missing", "target": "rr-workflow", "remove": ["task_order"], "expect": "task_order_missing"},
    {"name": "task order empty", "target": "rr-workflow", "set": {"task_order": []}, "expect": "task_order_missing"},
    {"name": "task order names an unmapped task", "target": "rr-workflow", "set": {"task_order": ["rr-workflow-task", "rr-missing"]}, "expect": "task_order_unmapped_task"},
    {"name": "task target is Batch", "target": "rr-workflow-task", "aws_service": "AWS Batch", "expect": "task_target_unsupported"},
    {"name": "task timeout missing", "target": "rr-workflow-task", "remove": ["timeout_minutes"], "expect": "timeout_missing"},
    {"name": "task timeout below Render minimum", "target": "rr-workflow-task", "remove": ["timeout_minutes"], "set": {"timeout_seconds": 20}, "expect": "timeout_out_of_bounds"},
    {"name": "task timeout above Render maximum", "target": "rr-workflow-task", "remove": ["timeout_minutes"], "set": {"timeout_seconds": 86401}, "expect": "timeout_out_of_bounds"},
    {"name": "Lambda timeout above 900 seconds", "target": "rr-workflow-task", "set": {"timeout_minutes": 16}, "expect": "lambda_timeout_over_900"},
    {"name": "retry omitted", "target": "rr-workflow-task", "remove": ["retry"], "expect": "retry_missing"},
    {"name": "retry wait not whole seconds", "target": "rr-workflow-task", "set": {"retry": {"max_retries": 3, "wait_duration_ms": 1500, "backoff_scaling": 2.0}}, "expect": "retry_invalid"},
    {"name": "retry backoff below 1", "target": "rr-workflow-task", "set": {"retry": {"max_retries": 3, "wait_duration_ms": 2000, "backoff_scaling": 0.5}}, "expect": "retry_invalid"},
    {"name": "retry with zero retries", "target": "rr-workflow-task", "set": {"retry": {"max_retries": 0, "wait_duration_ms": 2000, "backoff_scaling": 2.0}}, "expect": "retry_invalid"},
    {"name": "retry with an undeclared field", "target": "rr-workflow-task", "set": {"retry": {"max_retries": 3, "wait_duration_ms": 2000, "backoff_scaling": 2.0, "jitter": true}}, "expect": "retry_invalid"},
    {"name": "fan-out above Map limit", "target": "rr-workflow-task", "set": {"fan_out": {"max_concurrency": 41}}, "expect": "fan_out_invalid"},
    {"name": "fan-out combined with callback", "target": "rr-workflow-task", "set": {"fan_out": {"max_concurrency": 2}}, "expect": "callback_fan_out_unsupported"},
    {"name": "callback on ECS task", "target": "rr-workflow-task", "aws_service": "ECS on Fargate task", "expect": "callback_ecs_unsupported"},
    {"name": "compensation task not mapped", "target": "rr-workflow-task", "set": {"compensation_task": "rr-missing"}, "expect": "compensation_invalid"},
    {"name": "compensation task inside task order", "target": "rr-workflow-task", "set": {"compensation_task": "rr-workflow-task"}, "expect": "compensation_invalid"}
  ]
}
