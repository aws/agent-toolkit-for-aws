{
  "mcpServers": {
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/aws/mcp-proxy-for-aws@3f655f0f5421b35fd3c2f0959996170d10286587",
        "mcp-proxy-for-aws",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--skip-auth",
        "--metadata",
        "INSTALL_SOURCE=agent-toolkit-data-analytics"
      ]
    },
    "spark-troubleshooting": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws-cli==2.0.0",
        "https://sagemaker-unified-studio-mcp.us-east-1.api.aws/spark-troubleshooting/mcp",
        "--service",
        "sagemaker-unified-studio-mcp",
        "--region",
        "us-east-1",
        "--read-timeout",
        "180"
      ]
    },
    "spark-code-recommendation": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws-cli==2.0.0",
        "https://sagemaker-unified-studio-mcp.us-east-1.api.aws/spark-code-recommendation/mcp",
        "--service",
        "sagemaker-unified-studio-mcp",
        "--region",
        "us-east-1",
        "--read-timeout",
        "180"
      ]
    }
  }
}
